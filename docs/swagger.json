              "schema": {
                "type": "object",
                "required": [
                  "password",
                  "token"
                ],
                "properties": {
                  "password": {
                    "description": "User's new password",
                    "type": "string",
                    "example": "222222"
                  },
                  "token": {
                    "description": "JWT token",
                    "type": "string",
